<?xml version="1.0"?>
<ruleset name="Mini Shop for Telegram">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/dev/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="mini-shop-for-telegram"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="mstg"/><element value="MiniShopTelegram"/></property>
		</properties>
	</rule>
</ruleset>
