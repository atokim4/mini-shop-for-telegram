# Optional overrides for the local dev and test scripts (export them in your shell; nothing reads a .env file).
# The plugin itself has no environment settings: the bot token is entered on its settings page.
PORT=9400                              # dev/start.sh: WordPress Playground port
FAKE_BOT_PORT=8081                     # dev/fake-bot-api.mjs
SITE_URL=http://127.0.0.1:9400         # tests/e2e/run.mjs
FAKE_BOT_URL=http://127.0.0.1:8081     # tests/e2e/run.mjs
CHROME_PATH=/usr/bin/google-chrome     # Playwright browser for E2E and Plugin Check
SHOTS=1                                # 0 = E2E skips writing docs/screenshots
